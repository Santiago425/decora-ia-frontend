# Name shown in the interface and the browser tab
VITE_APP_NAME=Habita
# Name of the assistant
VITE_ASSISTANT_NAME=Lumi
# Backend base URL (without /api/v1)
VITE_API_URL=http://localhost:8000
# API prefix configured in the backend
VITE_API_PREFIX=/api/v1
# Local dev server port
VITE_DEV_PORT=5173
# Maximum time to wait for a normal request, in milliseconds
VITE_REQUEST_TIMEOUT_MS=60000
# Maximum time to wait for the AI to redesign a photo, in milliseconds
VITE_AI_TIMEOUT_MS=180000
# Photos are reduced to this longest side before uploading
VITE_MAX_PHOTO_SIDE=2048
# Currency and locale used to format prices
VITE_CURRENCY=COP
VITE_LOCALE=es-CO
# Background photo of the login screen (free license) and its credits
VITE_AUTH_IMAGE_URL=https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1920&q=80
# Banner photo of the dashboard
VITE_DASHBOARD_BANNER_URL=https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=1800&q=80
VITE_PHOTO_CREDITS_NAME=Unsplash
VITE_PHOTO_CREDITS_URL=https://unsplash.com/license
