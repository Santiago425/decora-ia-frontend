# Name shown in the interface and the browser tab
VITE_APP_NAME=Habita
# Name of the assistant
VITE_ASSISTANT_NAME=Lumi
# Backend base URL (without /api/v1)
VITE_API_URL=https://decora-ia-backend.onrender.com
# API prefix configured in the backend
VITE_API_PREFIX=/api/v1
# Maximum time to wait for a normal request, in milliseconds
VITE_REQUEST_TIMEOUT_MS=60000
# Maximum time to wait for the AI to redesign a photo, in milliseconds
VITE_AI_TIMEOUT_MS=180000
# Photos are reduced to this longest side before uploading
VITE_MAX_PHOTO_SIDE=2048
# 3D editor: grid snap in meters, move and rotate steps, undo history size and autosave delay
VITE_EDITOR_SNAP=0.05
VITE_EDITOR_MOVE_STEP=0.1
VITE_EDITOR_ROTATE_STEP=15
VITE_EDITOR_HISTORY_LIMIT=100
VITE_EDITOR_AUTOSAVE_MS=1500
# Distance in meters between a duplicated piece and the original
VITE_EDITOR_DUPLICATE_OFFSET=0.3
VITE_EDITOR_OVERLAP_TOLERANCE=0.02
VITE_EDITOR_EYE_HEIGHT=1.6
# Floor sizes offered when choosing a room, as WIDTHxLENGTH in meters
VITE_ROOM_SIZE_PRESETS=3x3,4x3,5x4,6x5
# How much a piece of furniture can shrink or grow from its catalog size
VITE_EDITOR_RESIZE_MIN_FACTOR=0.5
VITE_EDITOR_RESIZE_MAX_FACTOR=2
# Currency and locale used to format prices
VITE_CURRENCY=COP
VITE_LOCALE=es-CO
# Login photos (free license), comma separated: they rotate with a fade every few seconds
VITE_AUTH_IMAGE_URL=https://images.unsplash.com/photo-1774200981075-a728eaaa3824?auto=format&fit=crop&w=1600&q=75,https://images.unsplash.com/photo-1759239572496-4ec13e7643d6?auto=format&fit=crop&w=1600&q=75,https://images.unsplash.com/photo-1699869653495-fe26f4c70b3e?auto=format&fit=crop&w=1600&q=75,https://images.unsplash.com/photo-1783990349147-906f62b882c1?auto=format&fit=crop&w=1600&q=75
# Banner photo of the dashboard
VITE_DASHBOARD_BANNER_URL=https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=1600&q=75
# Soft interior photo for empty states, errors and the 404 page
VITE_DASHBOARD_BACKDROP_URL=https://images.unsplash.com/photo-1583847268964-b28dc8f51f92?auto=format&fit=crop&w=2000&q=70

VITE_EMPTY_STATE_IMAGE_URL=https://images.unsplash.com/photo-1788204996840-9d6b6f48b683?auto=format&fit=crop&w=1200&q=75
# Background photos are asked at these widths (srcset) so they stay sharp up to 2K screens
VITE_PHOTO_WIDTHS=960,1440,1920,2560
VITE_PHOTO_DEFAULT_WIDTH=1920
VITE_PHOTO_QUALITY=80
# Time each photo of a carousel stays on screen, in milliseconds
VITE_PHOTO_INTERVAL_MS=6000
VITE_RECENT_REDESIGNS_LIMIT=6
VITE_PHOTO_CREDITS_NAME=Unsplash
VITE_PHOTO_CREDITS_URL=https://unsplash.com/license
